# ── Server ──────────────────────────────────────────────
PORT=5100

# ── Database provider switch ───────────────────────────
# "mongodb" for now (free tier, dev/test). Change to "postgres"
# when you launch and move to Render's Postgres — that's the
# ONLY line you need to change to switch databases.
DATABASE_PROVIDER=mongodb

# ── MongoDB (used when DATABASE_PROVIDER=mongodb) ──────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ibr_cleaning?retryWrites=true&w=majority
MONGODB_POOL_SIZE=10

# ── PostgreSQL (used when DATABASE_PROVIDER=postgres) ──
DATABASE_URL=postgresql://postgres:password@localhost:5432/ibr_cleaning?schema=public

# ── Email ───────────────────────────────────────────────
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── Admin auth ──────────────────────────────────────────
# The admin's real password now lives HASHED in the database (Mongo or
# Postgres, whichever DATABASE_PROVIDER points at) — not here. These two
# lines are only read ONCE, by `npm run seed:admin`, to create that first
# admin account. Delete them from this file right after running the seed
# script; nothing at runtime reads ADMIN_SEED_* again.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_this_before_seeding

# Used every request to sign/verify admin JWTs — this one stays.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=replace_with_a_long_random_string

# ── Frontend ────────────────────────────────────────────
VITE_API_URL=http://localhost:5100
CORS_ORIGIN=http://localhost:5173

# ── Twilio (optional — WhatsApp notifications are currently
#    commented out in contactController.js; fill these in when
#    that feature gets turned back on) ────────────────────
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+2348012345678

# ── Payments (Paystack or Flutterwave) ──────────────────
# Choose one provider by setting PAYMENT_PROVIDER=paystack or flutterwave
PAYMENT_PROVIDER=paystack

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# Flutterwave (if using flutterwave instead)
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_your_secret_key
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_your_public_key
# FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Payment callback URL (where the gateway redirects after payment)
# In production, set this to your live domain, e.g. https://lbrcleaning.com/api/payment/verify
PAYMENT_CALLBACK_URL=http://localhost:5100/api/payment/verify
